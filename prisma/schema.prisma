generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                               String                            @id @default(uuid()) @db.Uuid
  larkRecordId                     String                            @unique @map("lark_record_id")
  startDateWork                    String?                           @map("start_date_work")
  employmentStatus                 String?                           @map("employment_status")
  fullNameLegal                    String?                           @map("full_name_legal")
  employeeCodePrimary              String?                           @map("employee_code_primary")
  jobTitle                         String?                           @map("job_title")
  directManager                    String?                           @map("direct_manager")
  gender                           String?                           @map("gender")
  email                            String?                           @map("email")
  birthDate                        String?                           @map("birth_date")
  phonePrimary                     String?                           @map("phone_primary")
  educationLevel                   String?                           @map("education_level")
  addressCurrent                   String?                           @map("address_current")
  addressHousehold                 String?                           @map("address_household")
  identityDocumentInfo             String?                           @map("identity_document_info")
  maritalStatus                    String?                           @map("marital_status")
  childrenInfo                     String?                           @map("children_info")
  emergencyContact1                String?                           @map("emergency_contact_1")
  schoolName                       String?                           @map("school_name")
  bankAccountInfo                  String?                           @map("bank_account_info")
  vehicleInfo                      String?                           @map("vehicle_info")
  hometownDetail                   String?                           @map("hometown_detail")
  familyNotes                      String?                           @map("family_notes")
  fatherGuardianContact            String?                           @map("father_guardian_contact")
  motherGuardianContact            String?                           @map("mother_guardian_contact")
  attachmentIdFront                String?                           @map("attachment_id_front")
  attachmentIdBack                 String?                           @map("attachment_id_back")
  facebookUrl                      String?                           @map("facebook_url")
  profileReviewDate                String?                           @map("profile_review_date")
  cvAttachmentRef                  String?                           @map("cv_attachment_ref")
  provinceAfterMerger              String?                           @map("province_after_merger")
  hometownNew                      String?                           @map("hometown_new")
  birthTime                        String?                           @map("birth_time")
  insuranceBookNumber              String?                           @map("insurance_book_number")
  cccdPhotoLink                    String?                           @map("cccd_photo_link")
  formSubmittedAt                  String?                           @map("form_submitted_at")
  confidentialityAgreement         String?                           @map("confidentiality_agreement")
  managerText                      String?                           @map("manager_text")
  rawData                          Json                              @map("raw_data")
  lastSyncedAt                     DateTime?                         @map("last_synced_at") @db.Timestamptz(6)
  createdAt                        DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  departmentId                     String?                           @map("department_id") @db.Uuid
  teamId                           String?                           @map("team_id") @db.Uuid
  adminUnitCode                    String?                           @map("admin_unit_code")
  managerBlockCode                 String?                           @map("manager_block_code")
  teamOrderNumber                  String?                           @map("team_order_number")
  submittedOn1                     String?                           @map("submitted_on_1")
  /// Phòng ban tổ chức (bảng `divisions`) — HR gán; có thể đồng bộ từ `team.team_group_id`.
  divisionId                       String?                           @map("division_id") @db.Uuid
  /// Chức vụ trong team (ví dụ: Trưởng nhóm, Phó nhóm, thành viên).
  teamPosition                     String?                           @map("team_position")
  /// Tên lớp đào tạo mà nhân sự đang tham gia.
  currentLearningClassName         String?                           @map("current_learning_class_name")
  displayName                      String?                           @map("display_name")
  contractType                     String?                           @map("contract_type")
  workplaceBranch                  String?                           @map("workplace_branch")
  emergencyContact2                String?                           @map("emergency_contact_2")
  ethnicity                        String?                           @map("ethnicity")
  religion                         String?                           @map("religion")
  policyAcknowledgement            String?                           @map("policy_acknowledgement")
  notes                            String?                           @map("notes")
  role                             UserAppRole                       @default(MEMBER)
  examSchedules                    LearningClassSchedule[]           @relation("ExamTeacher")
  classEvaluations                 ClassEvaluation[]                 @relation("ClassEvaluationUser")
  reviewedClassRegistrations       LearningClassRegistration[]       @relation("LearningClassRegistrationReviewer")
  learningClassRegistrations       LearningClassRegistration[]       @relation("LearningClassRegistrationUser")
  learningSessionMakeups           LearningSessionMakeup[]           @relation("LearningSessionMakeupUser")
  learningRoadmapItemCompletions   LearningRoadmapItemCompletion[]   @relation("LearningRoadmapItemCompletionUser")
  examAttempts                     ExamAttempt[]
  examSubmissions                  ExamSubmission[]
  examSubmissionFeedbacks          ExamSubmissionFeedback[]          @relation("ExamSubmissionFeedbackUser")
  learningClassMemberAssignments   LearningClassMember[]             @relation("LearningClassMemberAssigner")
  learningClassMemberships         LearningClassMember[]             @relation("LearningClassMemberUser")
  createdLearningClasses           LearningClass[]                   @relation("LearningClassCreator")
  teachingLearningClasses          LearningClass[]                   @relation("LearningClassTeacher")
  learningEvidences                LearningEvidence[]                @relation("UserLearningEvidence")
  performanceAnswers               PerformanceAnswer[]               @relation("PerformanceAnswerRespondent")
  performanceAssignmentsAsAssignee PerformanceAssignment[]           @relation("PerformanceAssignmentAssignee")
  performanceAssignmentsCreated    PerformanceAssignment[]           @relation("PerformanceAssignmentCreatedBy")
  performanceSummaries             PerformanceSummary[]              @relation("PerformanceSummaryAssignee")
  performanceTeamEvaluations       PerformanceTeamEvaluation[]       @relation("PerformanceTeamEvaluationEvaluatee")
  rewardRecords                    RewardRecord[]                    @relation("RewardRecordUser")
  createdRewards                   RewardRecord[]                    @relation("RewardRecordCreatedBy")
  permissionAssignments            PermissionAssignment[]
  promotionHistory                 PromotionHistory[]
  generalProfile                   StaffGeneral?
  highlightAchievements            StaffHighlightAchievement[]
  probationProfile                 StaffProbation?
  proficientProfile                StaffProficient?
  appProfile                       UserAppProfile?
  careerState                      UserCareerState?
  milestoneProgress                UserMilestoneProgress[]
  meetingBookings                  MeetingBooking[]
  chatAudits                       ChatAudit[]
  workReports                      WorkReport[]                      @relation("WorkReportUser")
  reviewedWorkReports              WorkReport[]                      @relation("WorkReportReviewer")
  lateRequests                     WorkReportLateRequest[]           @relation("LateRequestUser")
  reviewedLateRequests             WorkReportLateRequest[]           @relation("LateRequestReviewer")
  submittedApprovalRequests        PerformanceApprovalRequest[]      @relation("ApprovalSubmittedBy")
  resolvedApprovalRequests         PerformanceApprovalRequest[]      @relation("ApprovalApprovedBy")
  goalReviewsReviewed              PerformanceAssignmentGoalReview[] @relation("GoalReviewReviewedBy")
  goalReviewsConfirmed             PerformanceAssignmentGoalReview[] @relation("GoalReviewConfirmedBy")
  department                       Department?                       @relation(fields: [departmentId], references: [id])
  division                         Division?                         @relation(fields: [divisionId], references: [id])
  team                             Team?                             @relation(fields: [teamId], references: [id])

  @@index([divisionId])
  @@index([email])
  @@index([jobTitle])
  @@index([employeeCodePrimary])
  @@index([role])
  @@map("users")
}

