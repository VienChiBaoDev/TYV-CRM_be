generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Nhân viên phòng khám — schema sẵn cho auth/role (implement sau)
model Staff {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  fullName         String            @map("full_name")
  role             StaffRole
  clinicBranch     ClinicBranch?     @map("clinic_branch")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  visitsCreated    MedicalVisit[]    @relation("VisitCreatedBy")
  visitsUpdated    MedicalVisit[]    @relation("VisitUpdatedBy")
  followUpsCreated PatientFollowUp[] @relation("FollowUpCreatedBy")
  followUpsUpdated PatientFollowUp[] @relation("FollowUpUpdatedBy")
  consultantServiceRecords PatientServiceRecord[] @relation("PatientServiceConsultant")
  telesaleServiceRecords  PatientServiceRecord[] @relation("PatientServiceTelesale")
  finalizedServiceRecords PatientServiceRecord[] @relation("PatientServiceFinalizedBy")
  
  processedPayments PatientPayment[] @relation("PaymentProcessedBy")
  
  @@index([role])
  @@index([clinicBranch])
  @@map("staff")
}

/// Bệnh nhân — hồ sơ bệnh án chính
model Patient {
  id               String            @id @default(uuid()) @db.Uuid
  patientCode      String            @unique @map("patient_code")
  fullName         String            @map("full_name")
  gender           Gender
  birthDate        DateTime?         @map("birth_date") @db.Date
  occupation       String?
  phone            String
  address          String?
  avatarInitials   String?           @map("avatar_initials")
  clinicBranch     ClinicBranch      @default(HANG_BONG) @map("clinic_branch")
  tags             String[]          @default([])
  dietRestrictions String[]          @default([]) @map("diet_restrictions")
  nextFollowUpDate DateTime?         @map("next_follow_up_date") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  source           String?
  customerStatus   CustomerStatus    @default(LEAD) @map("customer_status")
  referrerId       String?           @map("referrer_id") @db.Uuid
  appointments     Appointment[]
  visits           MedicalVisit[]
  followUps        PatientFollowUp[]
  referrer         Referrer?              @relation(fields: [referrerId], references: [id])
  treatmentPlans   TreatmentPlan[]
  serviceRecords   PatientServiceRecord[]
  
  payments         PatientPayment[]

  @@index([fullName])
  @@index([phone])
  @@index([clinicBranch])
  @@index([nextFollowUpDate])
  @@index([customerStatus])
  @@index([referrerId])
  @@map("patients")
}

/// Lượt khám — phiếu khám từng lần
model MedicalVisit {
  id                  String               @id @default(uuid()) @db.Uuid
  patientId           String               @map("patient_id") @db.Uuid
  visitNumber         Int                  @map("visit_number")
  title               String
  visitDate           DateTime             @map("visit_date") @db.Date
  doctorName          String               @map("doctor_name")
  mode                VisitMode
  location            String
  bloodPressure       String?              @map("blood_pressure")
  pulse               String?
  symptoms            String?
  pulseDiagnosisTa    String?              @map("pulse_diagnosis_ta")
  pulseDiagnosisHuu   String?              @map("pulse_diagnosis_huu")
  pulseDiagnosisBung  String?              @map("pulse_diagnosis_bung")
  prescriptionFormula String?              @map("prescription_formula")
  prescriptionDosage  String?              @map("prescription_dosage")
  labResults          String?              @map("lab_results")
  status              VisitStatus
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         String?              @map("created_by_id") @db.Uuid
  updatedById         String?              @map("updated_by_id") @db.Uuid
  createdBy           Staff?               @relation("VisitCreatedBy", fields: [createdById], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy           Staff?               @relation("VisitUpdatedBy", fields: [updatedById], references: [id])
  followUpsCompleted  PatientFollowUp[]    @relation("FollowUpCompletedVisit")
  followUpsOriginated PatientFollowUp[]    @relation("FollowUpOriginatingVisit")
  clinicalImages      VisitClinicalImage[]
  herbs               VisitHerb[]

  @@unique([patientId, visitNumber])
  @@index([patientId, visitDate(sort: Desc)])
  @@index([status])
  @@map("medical_visits")
}

/// Thành phần thuốc trong đơn của một lượt khám
model VisitHerb {
  id        String       @id @default(uuid()) @db.Uuid
  visitId   String       @map("visit_id") @db.Uuid
  name      String
  weight    String
  sortOrder Int          @default(0) @map("sort_order")
  visit     MedicalVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, sortOrder])
  @@map("visit_herbs")
}

/// Hình ảnh lâm sàng đính kèm lượt khám
model VisitClinicalImage {
  id          String                @id @default(uuid()) @db.Uuid
  visitId     String                @map("visit_id") @db.Uuid
  imageUrl    String                @map("image_url")
  sortOrder   Int                   @default(0) @map("sort_order")
  storagePath String?               @map("storage_path")
  category    ClinicalImageCategory @default(OTHER)
  visit       MedicalVisit          @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, category, sortOrder])
  @@map("visit_clinical_images")
}

/// Gói / kế hoạch điều trị (ví dụ: COMBO VÙNG BỤNG)
model TreatmentPlan {
  id                String              @id @default(uuid()) @db.Uuid
  patientId         String              @map("patient_id") @db.Uuid
  name              String
  consultantName    String?             @map("consultant_name")
  totalSessions     Int                 @map("total_sessions")
  completedSessions Int                 @default(0) @map("completed_sessions")
  activeSession     Int                 @default(1) @map("active_session")
  status            TreatmentPlanStatus @default(IN_PROGRESS)
  startedAt         DateTime?           @map("started_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessions          TreatmentSession[]

  @@index([patientId, status])
  @@map("treatment_plans")
}

/// Buổi điều trị cụ thể trong một gói điều trị
model TreatmentSession {
  id                  String        @id @default(uuid()) @db.Uuid
  treatmentPlanId     String        @map("treatment_plan_id") @db.Uuid
  sessionNumber       Int           @map("session_number")
  doctorName          String?       @map("doctor_name")
  ptKtvName           String?       @map("pt_ktv_name")
  professionalSupport String?       @map("professional_support")
  treatmentContent    String?       @map("treatment_content")
  note                String?
  nextContent         String?       @map("next_content")
  nextTreatmentDate   DateTime?     @map("next_treatment_date") @db.Timestamptz(6)
  performedAt         DateTime?     @map("performed_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  treatmentPlan       TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@unique([treatmentPlanId, sessionNumber])
  @@index([treatmentPlanId, sessionNumber])
  @@map("treatment_sessions")
}

/// Chu kỳ tái khám & hỏi thăm — sinh ra từ một lượt khám
model PatientFollowUp {
  id                 String                    @id @default(uuid()) @db.Uuid
  patientId          String                    @map("patient_id") @db.Uuid
  originatingVisitId String                    @map("originating_visit_id") @db.Uuid
  completedVisitId   String?                   @map("completed_visit_id") @db.Uuid
  followUpDate       DateTime                  @map("follow_up_date") @db.Date
  assessmentDate     DateTime                  @map("assessment_date") @db.Date
  physicianInCharge  String                    @map("physician_in_charge")
  facility           ClinicBranch              @default(HANG_BONG)
  scheduleStatus     FollowUpScheduleStatus    @default(NOT_SCHEDULED) @map("schedule_status")
  assessmentResult   ClinicalAssessmentResult? @map("assessment_result")
  assessmentNote     String?                   @map("assessment_note")
  assessedAt         DateTime?                 @map("assessed_at") @db.Timestamptz(6)
  createdById        String?                   @map("created_by_id") @db.Uuid
  updatedById        String?                   @map("updated_by_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedVisit     MedicalVisit?             @relation("FollowUpCompletedVisit", fields: [completedVisitId], references: [id])
  createdBy          Staff?                    @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  originatingVisit   MedicalVisit              @relation("FollowUpOriginatingVisit", fields: [originatingVisitId], references: [id], onDelete: Cascade)
  patient            Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy          Staff?                    @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id])

  @@index([followUpDate, scheduleStatus])
  @@index([assessmentDate, assessmentResult])
  @@index([patientId])
  @@index([originatingVisitId])
  @@index([createdById])
  @@map("patient_follow_ups")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  patientId    String            @map("patient_id") @db.Uuid
  scheduledAt  DateTime          @map("scheduled_at") @db.Timestamptz(6)
  endedAt      DateTime          @map("ended_at") @db.Timestamptz(6)
  doctorName   String?           @map("doctor_name")
  clinicBranch ClinicBranch      @default(HANG_BONG) @map("clinic_branch")
  status       AppointmentStatus @default(BOOKED)
  note         String?
  visitId      String?           @map("visit_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model Referrer {
  id             String    @id @default(uuid()) @db.Uuid
  fullName       String    @map("full_name")
  phone          String?
  type           String?
  commissionRate Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  patients       Patient[]

  @@index([fullName])
  @@index([phone])
  @@map("referrers")
}

model ServiceGroup {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  itemType  ServiceItemType   @map("item_type")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  services  CatalogService[]
  @@map("service_groups")
}

model CatalogService {
  id             String               @id @default(uuid()) @db.Uuid
  code           String               @unique
  name           String
  groupId        String               @map("group_id") @db.Uuid
  itemType       ServiceItemType      @map("item_type")
  price          Decimal              @db.Decimal(12, 2)
  alternatePrice Decimal              @map("alternate_price") @db.Decimal(12, 2)
  unit           String
  status         CatalogServiceStatus @default(ACTIVE)
  minPriceVat    Decimal?             @map("min_price_vat") @db.Decimal(12, 2)
  maxPriceVat    Decimal?             @map("max_price_vat") @db.Decimal(12, 2)
  treatmentCount Int                  @default(1) @map("treatment_count")
  expiryDays     Int?                 @map("expiry_days")
  note           String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  group               ServiceGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  patientServiceRecords PatientServiceRecord[]
  @@index([groupId])
  @@index([status])
  @@index([itemType])
  @@map("catalog_services")
}

/// Kho thuốc — dùng khi kê đơn trong lượt khám
model Medicine {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  unit      String
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  category  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([name])
  @@index([unit])
  @@map("medicines")
}

/// Dịch vụ của mỗi bệnh nhân
model PatientServiceRecord {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @map("patient_id") @db.Uuid
  catalogServiceId  String   @map("catalog_service_id") @db.Uuid
  serviceCode       String   @map("service_code")
  serviceName       String   @map("service_name")

  consultantId      String   @map("consultant_id") @db.Uuid
  telesaleId        String?  @map("telesale_id") @db.Uuid
  finalizedById     String   @map("finalized_by_id") @db.Uuid

  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  vatPercent        Decimal  @map("vat_percent") @db.Decimal(5, 2)
  vatAmount         Decimal  @map("vat_amount") @db.Decimal(12, 2)
  unitPriceAfterVat Decimal  @map("unit_price_after_vat") @db.Decimal(12, 2)
  quantity          Int
  discount          Decimal  @default(0) @db.Decimal(12, 2)
  finalAmount       Decimal  @map("final_amount") @db.Decimal(12, 2)
  listPrice         Decimal? @map("list_price") @db.Decimal(12, 2)

  completedSessions Int      @default(0) @map("completed_sessions")
  treatmentCount    Int      @default(0) @map("treatment_count")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  note              String?

  finalizedAt       DateTime @default(now()) @map("finalized_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  catalogService CatalogService @relation(fields: [catalogServiceId], references: [id], onDelete: Restrict)
  consultant     Staff          @relation("PatientServiceConsultant", fields: [consultantId], references: [id])
  telesale       Staff?         @relation("PatientServiceTelesale", fields: [telesaleId], references: [id])
  finalizedBy    Staff          @relation("PatientServiceFinalizedBy", fields: [finalizedById], references: [id])

  paidAmount  Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentLines PatientPaymentLine[]

  @@index([patientId, finalizedAt(sort: Desc)])
  @@map("patient_service_records")
}

/// Phiếu thu thanh toán của bệnh nhân
model PatientPayment {
  id            String        @id @default(uuid()) @db.Uuid
  patientId     String        @map("patient_id") @db.Uuid
  voucherCode   String        @unique @map("voucher_code")
  paymentMethod PaymentMethod @map("payment_method")
  paymentDetail String?       @map("payment_detail")
  bankCode      String?       @map("bank_code")
  branch        String
  content       String?
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  processedById String        @map("processed_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  processedBy Staff                @relation("PaymentProcessedBy", fields: [processedById], references: [id])
  lines       PatientPaymentLine[]

  @@index([patientId, createdAt(sort: Desc)])
  @@map("patient_payments")
}

/// Chi tiết từng dòng trong phiếu thu
/// Patient Payment Line là để tạo dữ liệu cho bảng patient_payment_line
/// bảng này là bảng liên kết giữa patient_payment và patient_service_record
/// ví dụ: một hóa đơn có nhiều dịch vụ, mỗi dịch vụ có một id riêng biệt
/// nên ta cần tạo dữ liệu cho bảng này
/// đây là bảng này sẽ được tạo khi tạo hóa đơn, hiển thị dữ liệu dịch vụ trong hóa đơn
model PatientPaymentLine {
  id                     String  @id @default(uuid()) @db.Uuid
  paymentId              String  @map("payment_id") @db.Uuid
  patientServiceRecordId String  @map("patient_service_record_id") @db.Uuid
  amount                 Decimal @db.Decimal(12, 2)
  serviceCode            String  @map("service_code")
  serviceName            String  @map("service_name")

  payment              PatientPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  patientServiceRecord PatientServiceRecord @relation(fields: [patientServiceRecordId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([patientServiceRecordId])
  @@map("patient_payment_lines")
}

enum ClinicalImageCategory {
  DIAGNOSIS
  LAB_RESULT
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum ClinicBranch {
  HANG_BONG
  CAU_GIAY
}

enum VisitMode {
  ONLINE
  IN_PERSON
}

enum VisitStatus {
  INITIAL_EXAM
  FOLLOW_UP
  ONLINE
  NEED_ADJUSTMENT
  PLANNED
}

enum TreatmentPlanStatus {
  IN_PROGRESS
  COMPLETED
}

enum FollowUpScheduleStatus {
  SCHEDULED
  NOT_SCHEDULED
}

enum ClinicalAssessmentResult {
  GOOD_PROGRESS
  NORMAL
  NEED_CONSULTATION
  GOOD_PROGRESS_ALT
  CANCELLED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  DONE
  NO_SHOW
  CANCELLED
}

enum CustomerStatus {
  LEAD
  EXAMINING
  IN_TREATMENT
  COMPLETED
  INACTIVE
}

enum StaffRole {
  ADMIN
  DOCTOR
  ASSISTANT
  STAFF
}

enum ServiceItemType {
  SERVICE
  PRODUCT
}

enum CatalogServiceStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}